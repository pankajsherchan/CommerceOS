def validateRequiredValue(String name, String value) {
  if (!value?.trim()) {
    error("${name} is required")
  }
}

def validateAwsRegion(String region) {
  if (!(region ==~ /[a-z]{2}(-[a-z]+)+-[0-9]+/)) {
    error('AWS_REGION must look like us-west-2.')
  }
}

def validateDockerTagPrefix(String prefix) {
  if (!(prefix ==~ /[a-z0-9][a-z0-9._-]*/)) {
    error('IMAGE_TAG_PREFIX must be a valid lowercase Docker tag prefix.')
  }
}

def validateEcrRepositoryName(String name, String value) {
  validateRequiredValue(name, value)
  if (!(value ==~ /[a-z0-9]+([._\/-][a-z0-9]+)*/)) {
    error("${name} must be a valid ECR repository name.")
  }
}

def withJenkinsAwsCredentials(String credentialsId, Closure body) {
  validateRequiredValue('AWS_CREDENTIALS_ID', credentialsId)

  withCredentials([[
    $class: 'AmazonWebServicesCredentialsBinding',
    credentialsId: credentialsId.trim(),
    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
  ]]) {
    body()
  }
}

def resolveEcrRepositoryUrl(String repositoryName, String region, String label) {
  validateEcrRepositoryName(label, repositoryName)

  return sh(
    label: "Resolve ${label} ECR repository URL",
    returnStdout: true,
    script: """
      aws ecr describe-repositories \\
        --region '${region}' \\
        --repository-names '${repositoryName}' \\
        --query 'repositories[0].repositoryUri' \\
        --output text
    """.stripIndent()
  ).trim()
}

pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timestamps()
  }

  environment {
    DOCKER_BUILDKIT = '1'
    AWS_REGION = 'us-west-2'
    AWS_CREDENTIALS_ID = 'aws-dev-credential'
    STOREFRONT_ECR_REPOSITORY_NAME = 'commerce-os-dev-storefront'
    API_ECR_REPOSITORY_NAME = 'commerce-os-dev-commerce-api'
    IMAGE_TAG_PREFIX = 'dev'
  }

  stages {
    stage('Verify AWS CLI') {
      steps {
        sh '''
            aws --version
        '''
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_SHORT_SHA = sh(
            label: 'Record short commit SHA',
            returnStdout: true,
            script: 'git rev-parse --short=12 HEAD'
          ).trim()
          env.IMAGE_COMBINED_TAG = "${env.IMAGE_TAG_PREFIX}-${env.GIT_SHORT_SHA}-b${env.BUILD_NUMBER}"
          env.IMAGE_LATEST_TAG = "${env.IMAGE_TAG_PREFIX}-latest"
        }
      }
    }

    stage('Verify AWS Access') {
      steps {
        script {
          validateAwsRegion(env.AWS_REGION)

          withJenkinsAwsCredentials(env.AWS_CREDENTIALS_ID) {
            sh(
              label: 'Verify AWS caller identity',
              script: """
                aws sts get-caller-identity \\
                  --region '${env.AWS_REGION}' \\
                  --query 'Account' \\
                  --output text >/dev/null
              """.stripIndent()
            )
          }
        }
      }
    }

    stage('Resolve ECR Repositories') {
      steps {
        script {
          validateAwsRegion(env.AWS_REGION)
          validateDockerTagPrefix(env.IMAGE_TAG_PREFIX)

          withJenkinsAwsCredentials(env.AWS_CREDENTIALS_ID) {
            env.STOREFRONT_ECR_REPOSITORY_URL = resolveEcrRepositoryUrl(
              env.STOREFRONT_ECR_REPOSITORY_NAME,
              env.AWS_REGION,
              'storefront'
            )
            env.API_ECR_REPOSITORY_URL = resolveEcrRepositoryUrl(
              env.API_ECR_REPOSITORY_NAME,
              env.AWS_REGION,
              'commerce API'
            )
          }

          validateRequiredValue('resolved STOREFRONT_ECR_REPOSITORY_URL', env.STOREFRONT_ECR_REPOSITORY_URL)
          validateRequiredValue('resolved API_ECR_REPOSITORY_URL', env.API_ECR_REPOSITORY_URL)
          echo "Storefront repository: ${env.STOREFRONT_ECR_REPOSITORY_URL}"
          echo "Commerce API repository: ${env.API_ECR_REPOSITORY_URL}"
          echo "Publishing image tag: ${env.IMAGE_COMBINED_TAG}"
          echo "Moving tag enabled: ${env.IMAGE_LATEST_TAG}"
        }
      }
    }

    stage('Build Storefront Image') {
      steps {
        sh(
          label: 'Build storefront image',
          script: """
            docker build \\
              --file apps/storefront/Dockerfile \\
              --tag '${env.STOREFRONT_ECR_REPOSITORY_URL}:${env.IMAGE_COMBINED_TAG}' \\
              --tag '${env.STOREFRONT_ECR_REPOSITORY_URL}:${env.IMAGE_LATEST_TAG}' \\
              apps/storefront
          """.stripIndent()
        )
      }
    }

    stage('Build Commerce API Image') {
      steps {
        sh(
          label: 'Build commerce API image',
          script: """
            docker build \\
              --file services/commerce-api/Dockerfile \\
              --tag '${env.API_ECR_REPOSITORY_URL}:${env.IMAGE_COMBINED_TAG}' \\
              --tag '${env.API_ECR_REPOSITORY_URL}:${env.IMAGE_LATEST_TAG}' \\
              services/commerce-api
          """.stripIndent()
        )
      }
    }

    stage('Push Images') {
      steps {
        script {
          def registry = env.STOREFRONT_ECR_REPOSITORY_URL.split('/')[0]
          withJenkinsAwsCredentials(env.AWS_CREDENTIALS_ID) {
            sh(
              label: "Authenticate Docker to ${registry}",
              script: """
                aws ecr get-login-password --region '${env.AWS_REGION}' | docker login --username AWS --password-stdin '${registry}'
              """.stripIndent()
            )
            sh(
              label: 'Push storefront image tags',
              script: """
                docker push '${env.STOREFRONT_ECR_REPOSITORY_URL}:${env.IMAGE_COMBINED_TAG}'
                docker push '${env.STOREFRONT_ECR_REPOSITORY_URL}:${env.IMAGE_LATEST_TAG}'
              """.stripIndent()
            )
            sh(
              label: 'Push commerce API image tags',
              script: """
                docker push '${env.API_ECR_REPOSITORY_URL}:${env.IMAGE_COMBINED_TAG}'
                docker push '${env.API_ECR_REPOSITORY_URL}:${env.IMAGE_LATEST_TAG}'
              """.stripIndent()
            )
          }
        }
      }
    }
  }

  post {
    success {
      echo "Published storefront and commerce API images with ${env.IMAGE_COMBINED_TAG}."
    }
  }
}
